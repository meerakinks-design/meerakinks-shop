# Copie ce fichier en .env.local (jamais commité) et remplis les valeurs.

# --- Base de données (Neon) ---------------------------------------------------
# URL poolée (host contenant « -pooler ») : utilisée par l'application
DATABASE_URL=
# URL directe : utilisée par `prisma migrate`
DIRECT_URL=

# --- Seed : UNIQUEMENT en local pour `npm run db:seed`, puis à supprimer -------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_STORE_NAME=
SEED_SELLER_WHATSAPP=
# 1 = ajoute 3 produits de démonstration (refusé en production)
SEED_DEMO=
# 1 = réinitialise le mot de passe d'un compte admin déjà existant
SEED_RESET_PASSWORD=

# --- Vitrine ------------------------------------------------------------------
# 1 = ouvre la commande en ligne : bouton « Commander » du panier ET POST /api/v1/orders (qui répond 503 sinon).
# À activer après les vérifications « Commande » du README, jamais avant la migration.
NEXT_PUBLIC_CHECKOUT_ENABLED=
# 1 = build SANS base de données (intégration continue uniquement). JAMAIS pour la production :
# les pages statiques doivent contenir le vrai catalogue.
SKIP_DB_AT_BUILD=
# Seed, facultatif : moyens de contact affichés sur la landing (adresses en https://)
SEED_CONTACT_EMAIL=
SEED_INSTAGRAM_URL=
SEED_TIKTOK_URL=
SEED_FACEBOOK_URL=

# --- Emails et tâche planifiée (étape 9) -------------------------------------
# Clé API Resend et expéditeur. SANS ELLES, rien n'est envoyé : les emails restent « en attente » dans la base et
# partent dès que les deux sont renseignés. L'expéditeur doit appartenir à un domaine VÉRIFIÉ dans Resend (SPF + DKIM) ;
# format : « Awa Beauty <commandes@votre-domaine.com> » ou « commandes@votre-domaine.com ».
RESEND_API_KEY=
EMAIL_FROM=
# Secret de la tâche planifiée /api/cron/send-emails : 16 caractères minimum (ex. `openssl rand -hex 32`).
# Vercel l'envoie tout seul en « Authorization: Bearer ». SANS lui, la route reste fermée (503).
CRON_SECRET=

# --- Photos (étape 2) ---------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Même valeur que CLOUDINARY_CLOUD_NAME : lue par le NAVIGATEUR pour afficher les médias du dossier public/ (logo…) depuis
# Cloudinary. Vide = le site sert ces fichiers lui-même. À renseigner APRÈS `npm run media:sync`, sinon les médias n'existent pas encore chez Cloudinary.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# URL complète du site, avec protocole (par ex. https://votre-domaine.com).
NEXT_PUBLIC_SITE_URL=
